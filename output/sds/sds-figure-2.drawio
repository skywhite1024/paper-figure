        <mxCell id="reward-code" value="def compute_reward(self):&#10;    env = self.env&#10;&#10;    forward_vel_reward = env.base_lin_vel[:,0]&#10;    angular_vel_penalty = torch.sum(torch.abs(env.base_ang_vel), dim=1)&#10;&#10;    ...&#10;&#10;    total_reward = forward_vel_reward - angular_vel_penalty + ...&#10;&#10;    # return total reward and individual reward components&#10;    return total_reward, {&#10;        &quot;forward_vel_reward&quot;: forward_vel_reward,&#10;        &quot;angular_vel_penalty&quot;: angular_vel_penalty," style="text;html=0;whiteSpace=nowrap;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#333333;fontSize=8.9;fontFamily=Courier New;fontStyle=0;align=left;verticalAlign=middle;spacing=0;dashed=0;fillOpacity=100;strokeOpacity=100;" vertex="1" parent="1">
