<mxfile host="app.diagrams.net" agent="paper-figure" paper-figure-provenance="{&quot;paper_title&quot;: &quot;DexMimicGen: Automated Data Generation for Bimanual Dexterous Manipulation via Imitation Learning&quot;, &quot;paper_url&quot;: &quot;https://arxiv.org/pdf/2410.24185v2&quot;, &quot;figure&quot;: &quot;Figure 3&quot;, &quot;license&quot;: &quot;http://arxiv.org/licenses/nonexclusive-distrib/1.0/&quot;, &quot;notes&quot;: &quot;Source-layout reconstruction using native PDF paths and live ordinary labels. Each source photograph, illustration or mathematical bitmap is an isolated insert with original clipping. No whole-figure raster backdrop. Native paths are not semantically attached connectors.&quot;, &quot;page&quot;: 4, &quot;status&quot;: &quot;figure_recreation&quot;, &quot;source_sha256&quot;: &quot;96349aac2708b5637bbbefa9964067b5ed7eac0fb51ba0248b8d8dcbe49352a2&quot;, &quot;source_crop_pdf_points&quot;: [52, 52, 559, 294], &quot;extraction_review&quot;: &quot;pending; native geometry extraction is not visual fidelity approval&quot;, &quot;font_substitutions&quot;: &quot;Arial or Courier New; source fonts recorded per text object&quot;, &quot;outlined_font_families&quot;: [&quot;CMM&quot;, &quot;CMSY&quot;, &quot;CMEX&quot;, &quot;CambriaMath&quot;], &quot;outlined_math_limit&quot;: &quot;Selected source mathematical fonts preserved as editable glyph outlines, not live equation/text objects.&quot;, &quot;dash_fidelity&quot;: &quot;PPTX uses the closest supported native preset, not exact PDF dash lengths. Draw.io retains interval lengths; PDF phase/caps are not preserved; zero intervals become 0.001 scene units.&quot;, &quot;extraction_warnings&quot;: [&quot;90 source clipping groups intersect crop; extracted paths require explicit clipping review&quot;, &quot;unhandled image/shading at seq 1: [73.1826400756836, 158.87744140625, 111.9517593383789, 197.65194702148438]; requires reviewed raster region&quot;, &quot;unhandled image/shading at seq 2: [116.595