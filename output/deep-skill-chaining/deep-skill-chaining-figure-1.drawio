<mxfile host="app.diagrams.net" agent="paper-figure" paper-figure-provenance="{&quot;paper_title&quot;: &quot;Option Discovery Using Deep Skill Chaining&quot;, &quot;paper_url&quot;: &quot;https://cs.brown.edu/people/gdk/pubs/dsc_deeprl_ws.pdf&quot;, &quot;figure&quot;: &quot;Figure 1&quot;, &quot;license&quot;: &quot;unverified&quot;, &quot;notes&quot;: &quot;Source-layout reconstruction using native PDF paths and live ordinary labels. Each source photograph, illustration or mathematical bitmap is an isolated insert with original clipping. No whole-figure raster backdrop. Native paths are not semantically attached connectors.&quot;, &quot;page&quot;: 14, &quot;status&quot;: &quot;figure_recreation&quot;, &quot;source_sha256&quot;: &quot;fb2b42a704404ec5ca14bb77e287c9128f7e85531545c34153c6654f4dcd7c54&quot;, &quot;source_crop_pdf_points&quot;: [105, 85, 506, 236], &quot;extraction_review&quot;: &quot;pending; native geometry extraction is not visual fidelity approval&quot;, &quot;font_substitutions&quot;: &quot;Arial or Courier New; source fonts recorded per text object&quot;, &quot;outlined_font_families&quot;: [&quot;CMM&quot;, &quot;CMSY&quot;, &quot;CMEX&quot;, &quot;CambriaMath&quot;], &quot;outlined_math_limit&quot;: &quot;Selected source mathematical fonts preserved as editable glyph outlines, not live equation/text objects.&quot;, &quot;dash_fidelity&quot;: &quot;PPTX uses the closest supported native preset, not exact PDF dash lengths. Draw.io retains interval lengths; PDF phase/caps are not preserved; zero intervals become 0.001 scene units.&quot;, &quot;extraction_warnings&quot;: [&quot;19 source clipping groups intersect crop; extracted paths require explicit clipping review&quot;], &quot;ignored_invisible_text_spans&quot;: 0, &quot;extraction_warnings_reviewed&quot;: [&quot;Source clipping and reconstructed preview inspected. Individual source image instances use original SVG clips and masks. Identified diagram arrows and gradient ovals are now native editable contours, ordinary panel labels typeable. Font-based checkmarks repaired against original source pixels.&quot;], &quot;text_editability&quot;: &quot;Ordinary source labels are live text; selected mathematical fonts are native outlines. Source image inserts retain internal raster pixels.&quot;, &quot;image_reconstruction&quot;: &quot;Each source raster instance is isolated with complete source SVG ancestry, source clipping, mask and paint order. No full-figure image is used.&quot;, &quot;native_raster_repairs&quot;: &quot;Nine source skill-region gradient ovals rebuilt with nested native grayscale contour layers. Four panel letters are live text; the original small robot illustrations remain individual source raster pieces.&quot;}">
