<mxfile host="app.diagrams.net" agent="paper-figure" paper-figure-provenance="{&quot;paper_title&quot;: &quot;Mutual Information State Intrinsic Control&quot;, &quot;paper_url&quot;: &quot;https://arxiv.org/abs/2103.08107v1&quot;, &quot;figure&quot;: &quot;Figure 1&quot;, &quot;license&quot;: &quot;No reuse license found in inspected source landing page; retain attribution and review reuse terms&quot;, &quot;notes&quot;: &quot;Original MUSIC algorithm composite: ordinary labels and pseudocode prose are typeable text interleaved with source mathematical glyph outlines. Left-panel formula bitmaps are traced from original alpha masks into individual editable contours. No full-figure or formula raster background remains. Native math paths are not live equations or semantic connectors.&quot;, &quot;page&quot;: 3, &quot;status&quot;: &quot;figure_recreation&quot;, &quot;source_sha256&quot;: &quot;fccb2c6c2463b42da75df0d35bb7f58a39be81b5a4544f2b1ab00b6e70e5fb17&quot;, &quot;source_crop_pdf_points&quot;: [106, 80, 505, 205], &quot;extraction_review&quot;: &quot;pending; native geometry extraction is not visual fidelity approval&quot;, &quot;font_substitutions&quot;: &quot;Ordinary labels/prose use Arial or Times New Roman, with explicit source-baseline adjustment. Source mathematical fonts and raster formulas use native glyph outlines.&quot;, &quot;outlined_font_families&quot;: [&quot;CMM&quot;, &quot;CMSY&quot;, &quot;CMEX&quot;, &quot;CMR&quot;], &quot;outlined_math_limit&quot;: &quot;Selected source mathematical fonts preserved as editable glyph outlines, not live equation/text objects.&quot;, &quot;extraction_warnings&quot;: [&quot;8 source clipping groups intersect crop; extracted paths require explicit clipping review&quot;, &quot;unhandled image/shading at seq 8: [196.89224243164062, 85.2252197265625, 203.75604248046875, 90.7690658569336]; requires reviewed raster region&quot;, &quot;unhandled image/shading at seq 11: [147.87142944335938, 96.48431396484375, 230.50108337402344, 105.98804473876953]; requires reviewed raster region&quot;, &quot;unhandled image/shading at seq 16: [118.65917205810547, 156.86976623535156, 174.8895721435547, 165.8455047607422]; requires reviewed raster region&quot;, &quot;unhandled image/shading at seq 24: [166.279541015625, 119.38119506835938, 173.14334106445312, 124.66104125976562]; requires reviewed raster region&quot;, &quot;unhandled image/shading at seq 32: [210.75843811035156, 119.44290161132812, 215.24630737304688, 123.40278625488281]; requires reviewed raster region&quot;, &quot;unhandled image/shading at seq 33: [215.7121124267578, 156.96304321289062, 269.83056640625, 166.73077392578125]; requires reviewed raster region&quot;, &quot;unhandled image/shading at seq 34: [165.52638244628906, 186.06124877929688, 222.28477478027344, 196.09295654296875]; requires reviewed raster region&quot;], &quot;raster_formula_reconstruction&quot;: &quot;Seven original transparent formula bitmaps individually traced as native editable glyph contours; antialias transitions approximated. No formula bitmap or panel screenshot retained.&quot;, &quot;extraction_warnings_reviewed&quot;: [&quot;Seven source image warnings resolved by editable point-path contours of their original masks. Clipping and source geometry reviewed against the original crop.&quot;], &quot;text_editability&quot;: &quot;Ordinary labels and prose remain native typeable text. Mathematical expressions are editable glyph-outline paths, not live equations.&quot;}">
